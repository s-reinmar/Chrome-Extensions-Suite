{
  "manifest_version": 3,
  "name": "Pobieracz",
  "version": "1.1",
  "description": "Wtyczka do pobierania zdjęć z aktywnych kart i ramek",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.ico"
  },
  "icons": {
    "16": "icon.ico",
    "48": "icon.ico",
    "128": "icon.ico"
  }
}