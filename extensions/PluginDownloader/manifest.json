{
  "manifest_version": 3,
  "name": "Pobieracz",
  "version": "1.8",
  "description": "Wtyczka do pobierania zdjęć z aktywnej karty. Wersja stabilna, działająca niezależnie od aktywnej karty przeglądarki. Szybkość i niezależność!",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
  "service_worker": "js/background.js",
  "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "img/icon.png"
  },
  "icons": {
    "128": "img/icon.png"
  }
}